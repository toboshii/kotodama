{
  "_comment": "Kotodama model adapters. Each entry under 'models' becomes a voice provider (//koto provider <name>). Override or add entries in server/config.json under 'models' (same shape; fields merge by name). See README: Replicate and other backends. minimax / minimax-hd use MiniMax's own streaming API (MINIMAX_API_KEY); minimax-replicate / minimax-replicate-hd run the same models through Replicate. gemini / gemini-lite use Google's streaming API (GEMINI_API_KEY).",

  "models": {
    "minimax": {
      "transport": "minimax",
      "model": "speech-2.8-turbo",
      "label": "MiniMax Speech 2.8 Turbo",
      "sample_rate": 24000,
      "input": {
        "voice_setting": {
          "voice_id": "{voice}",
          "speed": "{speed}",
          "pitch": "{pitch}",
          "vol": 1
        }
      },
      "controls": {
        "pitch": {
          "very low": -3,
          "low": -1,
          "medium": 0,
          "high": 1,
          "very high": 3
        }
      },
      "ranges": {
        "voice_setting.speed": [
          0.5,
          2.0
        ],
        "voice_setting.pitch": [
          -12,
          12
        ]
      },
      "voices": [
        "@minimax_en",
        "@minimax_legacy",
        "account"
      ],
      "default_voice": "English_Trustworth_Man"
    },

    "minimax-hd": {
      "transport": "minimax",
      "model": "speech-2.8-hd",
      "label": "MiniMax Speech 2.8 HD",
      "sample_rate": 24000,
      "input": {
        "voice_setting": {
          "voice_id": "{voice}",
          "speed": "{speed}",
          "pitch": "{pitch}",
          "vol": 1
        }
      },
      "controls": {
        "pitch": {
          "very low": -3,
          "low": -1,
          "medium": 0,
          "high": 1,
          "very high": 3
        }
      },
      "ranges": {
        "voice_setting.speed": [
          0.5,
          2.0
        ],
        "voice_setting.pitch": [
          -12,
          12
        ]
      },
      "voices": [
        "@minimax_en",
        "@minimax_legacy",
        "account"
      ],
      "default_voice": "English_Trustworth_Man"
    },

    "minimax-replicate": {
      "transport": "replicate",
      "model": "minimax/speech-2.8-turbo",
      "official": true,
      "label": "MiniMax Speech 2.8 Turbo",
      "sample_rate": 24000,
      "max_chars": 3000,
      "split": "sentences",
      "input": {
        "text": "{text}",
        "voice_id": "{voice}",
        "speed": "{speed}",
        "pitch": "{pitch}",
        "emotion": "auto",
        "audio_format": "wav",
        "sample_rate": 24000,
        "channel": "mono"
      },
      "controls": {
        "pitch": {
          "very low": -3,
          "low": -1,
          "medium": 0,
          "high": 1,
          "very high": 3
        }
      },
      "ranges": {
        "speed": [
          0.5,
          2.0
        ],
        "pitch": [
          -12,
          12
        ]
      },
      "voices": [
        "@minimax_en",
        "@minimax_legacy"
      ],
      "cache_name": "minimax"
    },

    "minimax-replicate-hd": {
      "transport": "replicate",
      "model": "minimax/speech-2.8-hd",
      "official": true,
      "label": "MiniMax Speech 2.8 HD",
      "sample_rate": 24000,
      "max_chars": 3000,
      "split": "sentences",
      "input": {
        "text": "{text}",
        "voice_id": "{voice}",
        "speed": "{speed}",
        "pitch": "{pitch}",
        "emotion": "auto",
        "audio_format": "wav",
        "sample_rate": 24000,
        "channel": "mono"
      },
      "controls": {
        "pitch": {
          "very low": -3,
          "low": -1,
          "medium": 0,
          "high": 1,
          "very high": 3
        }
      },
      "ranges": {
        "speed": [
          0.5,
          2.0
        ],
        "pitch": [
          -12,
          12
        ]
      },
      "voices": [
        "@minimax_en",
        "@minimax_legacy"
      ],
      "cache_name": "minimax-hd"
    },

    "gemini": {
      "transport": "gemini",
      "model": "gemini-3.8-flash-tts",
      "label": "Gemini 3.8 Flash TTS",
      "sample_rate": 24000,
      "input": {
        "style": "{style}"
      },
      "voices": [
        "@gemini_prebuilt",
        "account"
      ],
      "remote_labels": true,
      "default_voice": "Kore"
    },

    "gemini-lite": {
      "transport": "gemini",
      "model": "gemini-3.8-flash-lite-tts",
      "label": "Gemini 3.8 Flash-Lite TTS",
      "sample_rate": 24000,
      "input": {
        "style": "{style}"
      },
      "voices": [
        "@gemini_prebuilt",
        "account"
      ],
      "remote_labels": true,
      "default_voice": "Kore"
    },

    "inworld": {
      "_comment": "Inworld Realtime TTS-2 through its OpenAI-compatible endpoint. Steering from the NPC's tone and personality; the price is the pay-as-you-go rate (plans are cheaper).",
      "transport": "inworld",
      "model": "inworld-tts-2",
      "label": "Inworld TTS-2",
      "sample_rate": 24000,
      "max_chars": 4000,
      "extra": {
        "instructions": "{steering}"
      },
      "ranges": {
        "speed": [0.5, 1.5]
      },
      "voices": [
        "@inworld_en",
        "account"
      ],
      "remote_labels": true,
      "default_voice": "Sarah",
      "price": {"per_1k_chars": 0.025}
    },

    "inworld-flash": {
      "_comment": "Inworld TTS-2 Flash: the fastest and cheapest; it ignores steering, so none is sent.",
      "transport": "inworld",
      "model": "inworld-tts-2-flash",
      "label": "Inworld TTS-2 Flash",
      "sample_rate": 24000,
      "max_chars": 4000,
      "ranges": {
        "speed": [0.5, 1.5]
      },
      "voices": [
        "@inworld_en",
        "account"
      ],
      "remote_labels": true,
      "default_voice": "Sarah",
      "price": {"per_1k_chars": 0.015}
    },

    "chatterbox-turbo": {
      "transport": "replicate",
      "model": "resemble-ai/chatterbox-turbo",
      "official": true,
      "label": "Chatterbox Turbo (Resemble AI)",
      "sample_rate": 24000,
      "max_chars": 500,
      "split": "sentences",
      "input": {
        "text": "{text}",
        "voice": "{voice}",
        "seed": "{seed}"
      },
      "input_clone": {
        "reference_audio": "{reference_audio}",
        "voice": null
      },
      "voices": [
        "schema",
        "bank"
      ]
    },

    "chatterbox": {
      "transport": "replicate",
      "model": "resemble-ai/chatterbox",
      "official": true,
      "label": "Chatterbox (Resemble AI)",
      "sample_rate": 24000,
      "max_chars": 600,
      "split": "sentences",
      "input": {
        "prompt": "{text}",
        "exaggeration": "{exaggeration}",
        "cfg_weight": "{cfg_weight}",
        "temperature": 0.8,
        "seed": "{seed}"
      },
      "input_clone": {
        "audio_prompt": "{reference_audio}"
      },
      "controls": {
        "exaggeration": {
          "expressive": 0.7,
          "steady": 0.35,
          "default": 0.5
        },
        "cfg_weight": {
          "expressive": 0.3,
          "default": 0.5
        }
      },
      "ranges": {
        "exaggeration": [
          0.25,
          2.0
        ],
        "cfg_weight": [
          0.0,
          1.0
        ]
      },
      "voices": [
        "bank"
      ]
    },

    "kokoro": {
      "transport": "replicate",
      "model": "jaaari/kokoro-82m",
      "official": false,
      "label": "Kokoro 82M",
      "sample_rate": 24000,
      "max_chars": 1000,
      "split": "sentences",
      "input": {
        "text": "{text}",
        "voice": "{voice}",
        "speed": "{speed}"
      },
      "ranges": {
        "speed": [
          0.5,
          2.0
        ]
      },
      "voices": [
        "@kokoro_en"
      ]
    },

    "qwen3": {
      "transport": "replicate",
      "model": "qwen/qwen3-tts",
      "official": true,
      "label": "Qwen3-TTS",
      "sample_rate": 24000,
      "max_chars": 1000,
      "split": "sentences",
      "input": {
        "mode": "custom_voice",
        "text": "{text}",
        "speaker": "{voice}",
        "language": "English",
        "style_instruction": "{style}"
      },
      "input_clone": {
        "mode": "voice_clone",
        "speaker": null,
        "reference_audio": "{reference_audio}",
        "reference_text": "{reference_text}"
      },
      "voices": [
        "schema",
        "bank"
      ]
    },

    "kokoro-local": {
      "enabled": false,
      "_comment": "Example: a Kokoro-FastAPI server on your network (OpenAI-compatible). Set enabled to true and base_url in server/config.json under models.kokoro-local.",
      "transport": "openai_compatible",
      "base_url": "http://127.0.0.1:8880/v1",
      "model": "kokoro",
      "label": "Kokoro (self-hosted)",
      "response_format": "pcm",
      "sample_rate": 24000,
      "voices": [
        "@kokoro_en"
      ],
      "default_voice": "af_bella"
    }
  },

  "designers": {
    "qwen3": {
      "transport": "replicate",
      "model": "qwen/qwen3-tts",
      "official": true,
      "sample_rate": 24000,
      "input": {
        "mode": "voice_design",
        "text": "{text}",
        "voice_description": "{voice_description}",
        "language": "English"
      }
    }
  },

