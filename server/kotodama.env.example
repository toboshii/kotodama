# Copy to server/kotodama.env (or ~/.config/kotodama.env, or
# %APPDATA%\Kotodama\kotodama.env on Windows) and fill in the keys you use.
# A server/kotodama.env takes precedence over the other two when it exists.
# Keep it private: chmod 600 server/kotodama.env
# Variables already set in your shell take precedence over this file.

INWORLD_API_KEY=
#ELEVENLABS_API_KEY=
#MINIMAX_API_KEY=
#GEMINI_API_KEY=
#OPENAI_API_KEY=sk-...
#REPLICATE_API_TOKEN=r8_...

# Optional: keep config.json somewhere else.
#KOTODAMA_CONFIG=/path/to/config.json
